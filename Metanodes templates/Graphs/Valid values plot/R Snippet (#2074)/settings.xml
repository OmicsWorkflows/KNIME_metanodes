        <entry key="script" type="xstring" value="suppressPackageStartupMessages(library(dplyr))%%00010suppressPackageStartupMessages(library(tidyr))%%00010suppressPackageStartupMessages(library(rstatix))%%00010suppressPackageStartupMessages(library(stats))%%00010suppressPackageStartupMessages(library(tibble))%%00010%%00010df &lt;- knime.in%%00010%%00010test_bool &lt;- ifelse(knime.flow.in[[&quot;design_bool&quot;]] == TRUE &amp; knime.flow.in[[&quot;test&quot;]] != 'none', TRUE, FALSE)%%00010%%00010if(test_bool) {%%00010%%00009if (knime.flow.in[[&quot;test&quot;]] == 'non-parametric') {%%00010%%00009%%00009if(length(unique(df$&quot;Group&quot;)) &gt; 2) {%%00010%%00009%%00009%%00009kw &lt;- kruskal.test(df$Count ~ df$Group)%%00010%%00009%%00009%%00009result &lt;- data.frame(Contrast = 'all',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Test = 'Kruskal-Wallis test',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 p = kw$p.value,%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Significance = case_when(kw$p.value &lt;= 0.05 &amp; kw$p.value &gt; 0.01 ~ '*',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 kw$p.value &lt;= 0.01 &amp; kw$p.value &gt; 0.001 ~ '**',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 kw$p.value &lt;= 0.001 ~ '***',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 TRUE ~ 'ns'))%%00010%%00009%%00009%%00009%%00010%%00009%%00009%%00009if(kw$p.value &lt;= 0.05) {%%00010%%00009%%00009%%00009%%00009result2 &lt;- dunn_test(data = df,Count ~ Group, p.adjust.method = 'bonferroni') |&gt;%%00010%%00009%%00009%%00009%%00009%%00009as.data.frame() |&gt;%%00010%%00009%%00009%%00009%%00009%%00009mutate(Contrast = paste0(group1, '-', group2),%%00010%%00009%%00009%%00009%%00009%%00009%%00009  Test = &quot;post-hoc Dunn's test&quot;) |&gt;%%00010%%00009%%00009%%00009%%00009%%00009select(Contrast, Test, p, p.adj, p.adj.signif) |&gt;%%00010%%00009%%00009%%00009%%00009%%00009rename(Significance = p.adj.signif)%%00010%%00009%%00009%%00009%%00009result &lt;- merge(result, result2, all = TRUE, sort = FALSE)%%00010%%00009%%00009%%00009%%00009result &lt;- relocate(result, Significance, .after = last_col())%%00010%%00009%%00009%%00009}%%00010%%00009%%00009} else {%%00010%%00009%%00009%%00009test &lt;- wilcox.test(df$Count ~ df$Group)%%00010%%00009%%00009%%00009result &lt;- data.frame(Contrast = paste0(unique(df$Group)[1], '-', unique(df$Group)[2]),%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Test = 'Mann-Whitney U test',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 p = test$p.value,%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Significance = case_when(test$p.value &lt;= 0.05 &amp; test$p.value &gt; 0.01 ~ '*',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 test$p.value &lt;= 0.01 &amp; test$p.value &gt; 0.001 ~ '**',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 test$p.value &lt;= 0.001 ~ '***',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 TRUE ~ 'ns'))%%00010%%00009%%00009}%%00010%%00009} else if (knime.flow.in[[&quot;test&quot;]] == 'parametric') {%%00010%%00009%%00009if(length(unique(df$&quot;Group&quot;)) &gt; 2) {%%00010%%00009%%00009%%00009test &lt;- aov(df$Count ~ df$Group)%%00010%%00009%%00009%%00009p.value &lt;- summary(test)[[1]][['Pr(&gt;F)']][[1]]%%00010%%00009%%00009%%00009result &lt;- data.frame(Contrast = 'all',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Test = 'ANOVA test',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 p = p.value,%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 Significance = case_when(p.value &lt;= 0.05 &amp; p.value &gt; 0.01 ~ '*',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 p.value &lt;= 0.01 &amp; p.value &gt; 0.001 ~ '**',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 p.value &lt;= 0.001 ~ '***',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 TRUE ~ 'ns'))%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009%%00009 %%00010%%00009%%00009%%00009if(p.value &lt;= 0.05) {%%00010%%00009%%00009%%00009%%00009result2 &lt;- TukeyHSD(test)[[1]] |&gt;%%00010%%00009%%00009%%00009%%00009%%00009as.data.frame() |&gt;%%00010%%00009%%00009%%00009%%00009%%00009rownames_to_column('Contrast')%%00010%%00009%%00009%%00009%%00009result2$Test &lt;- &quot;post-hoc TukeyHSD test&quot;%%00010%%00009%%00009%%00009%%00009result2 &lt;- result2 |&gt;%%00010%%00009%%00009%%00009%%00009%%00009mutate(Significance = case_when(`p adj` &lt;= 0.05 &amp; `p adj` &gt; 0.01 ~ '*',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009   %%00009  `p adj` &lt;= 0.01 &amp; `p adj` &gt; 0.001 ~ '**',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009  `p adj` &lt;= 0.001 ~ '***',%%00010%%00009%%00009%%00009%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00009  TRUE ~ 'ns')) |&gt;%%00010%%00009%%00009%%00009%%00009%%00009select(Contrast, Test, `p adj`, Significance) |&gt;%%00010%%00009%%00009%%00009%%00009%%00009rename(p.adj = `p adj`)%%00010%%00009%%00009%%00009%%00009result &lt;- merge(result, result2, all = TRUE, sort = FALSE)%%00010%%00009%%00009%%00009}%%00009%%00009%%00009%%00009 %%00009%%00009%%00009%%00010%%00009%%00009}%%00010%%00009}%%00010} else {%%00010%%00009result &lt;- data.frame()%%00010}%%00010%%00010knime.out &lt;- result"/>
